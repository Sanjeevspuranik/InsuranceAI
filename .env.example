# Copy this file to .env and add your API key.
OPENAI_API_KEY=

# Model used by InsuranceAI.
OPENAI_MODEL=gpt-6-luna

# Optional: set this for an OpenAI-compatible provider.
# OPENAI_BASE_URL=

# API runtime and local SQLite database.
APP_ENV=development
DATABASE_URL=sqlite:///./data/insuranceai.db
STORAGE_URL=file:./data/storage

# Development authentication. Use the same token in frontend/.env.local.
API_AUTH_MODE=development
API_DEV_TOKEN=change-this-local-development-token
DEFAULT_TENANT_ID=local

# For production OIDC authentication, set API_AUTH_MODE=oidc and configure:
# OIDC_ISSUER_URL=https://identity.example.com/realms/insuranceai
# OIDC_JWKS_URL=https://identity.example.com/realms/insuranceai/protocol/openid-connect/certs
# OIDC_AUDIENCE=insuranceai-api
# OIDC_TENANT_CLAIM=tenant_id

# Local frontend and upload settings.
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=20971520
WORKER_POLL_SECONDS=1
LOG_LEVEL=INFO

# Optional S3-compatible storage settings when STORAGE_URL=s3://bucket/prefix.
# S3_ENDPOINT_URL=
