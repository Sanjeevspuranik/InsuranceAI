APP_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-local-secret

NEXT_PUBLIC_AUTH_MODE=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000
API_DEV_TOKEN=change-this-local-development-token
# Optional comma-separated host/IPs for LAN access to the Next.js dev server.
NEXT_ALLOWED_DEV_ORIGINS=

# For production OIDC, set NEXT_PUBLIC_AUTH_MODE=oidc and configure:
# OIDC_ISSUER_URL=https://identity.example.com/realms/insuranceai
# OIDC_CLIENT_ID=insuranceai-web
# OIDC_CLIENT_SECRET=replace-with-your-client-secret
